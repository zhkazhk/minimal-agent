# ============================================================================
# minimal-agent 配置示例：复制为 .env 并按需修改
#   cp .env.example .env        (Windows: copy .env.example .env)
# AgentConfig.from_env() 会自动读取本文件，环境变量优先级高于 .env
# ============================================================================

# ---------------- LLM（OpenAI 兼容接口）----------------
# provider: deepseek / openai / moonshot / dashscope / siliconflow / zhipu / ollama / vllm
#           或填 mock（离线规则客户端，不需要 API Key，用于本地跑通用例）
MINIAGENT_PROVIDER=deepseek

# OpenAI 兼容地址（不带 /chat/completions，程序会自动补）
#   DeepSeek : https://api.deepseek.com/v1
#   OpenAI   : https://api.openai.com/v1
#   通义千问 : https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地Ollama: http://localhost:11434/v1
MINIAGENT_BASE_URL=https://api.deepseek.com/v1

# API Key（也可用 OPENAI_API_KEY / DEEPSEEK_API_KEY）
MINIAGENT_API_KEY=sk-your-key-here

# 模型名；留空则按 provider 取默认值（deepseek-chat / gpt-4o-mini / qwen-plus …）
MINIAGENT_MODEL=deepseek-chat

MINIAGENT_TEMPERATURE=0.2
MINIAGENT_MAX_TOKENS=1024
MINIAGENT_TIMEOUT=60
MINIAGENT_MAX_RETRIES=3
# HTTP 传输后端：stdlib（默认，零依赖）/ httpx / aiohttp
MINIAGENT_HTTP_BACKEND=stdlib

# ---------------- 循环与轮次 ----------------
# 单次提问最多允许的工具调用轮次，超过后强制 LLM 直接总结
MINIAGENT_MAX_TOOL_TURNS=10
# 连续解析失败上限（超过则返回可读兜底文案）
MINIAGENT_MAX_PARSE_RETRIES=3
# 单个工具执行超时（秒）；同步 handler 会被放进线程池执行
MINIAGENT_TOOL_TIMEOUT=10

# ---------------- 上下文管理 ----------------
# token 预算（启发式估算）与消息条数上限，超过则裁剪最早的对话
MINIAGENT_MAX_CONTEXT_TOKENS=3000
MINIAGENT_MAX_CONTEXT_MESSAGES=40
# 裁剪时至少保留最近 N 条消息
MINIAGENT_KEEP_RECENT_MESSAGES=12
MINIAGENT_ENABLE_COMPRESSION=true

# ---------------- 会话与日志 ----------------
# 是否把会话落盘（logs/sessions.json），默认关闭（纯内存）
MINIAGENT_PERSIST_SESSIONS=false
MINIAGENT_LOG_DIR=logs
# 是否在控制台实时打印 trace
MINIAGENT_CONSOLE_TRACE=true
